{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bancada",
  "version": "0.1.0",
  "identifier": "com.bancada.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bancada",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": ["../bin/realesrgan"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Portuguese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEREE4NDlGMkI2NUE1QjMKUldTenBXVXJuNFRhSGZ0dFhHK1UydG9WQlBvZzg4U1ZvdldyR0JqMFFiQ0R6SnlYSXYrWnZuOUIK",
      "endpoints": [
        "https://github.com/MullerDeFranca/central-de-trabalho/releases/latest/download/latest.json"
      ]
    }
  }
}
